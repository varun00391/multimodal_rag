# =============================================================================
# Multimodal PDF Extraction — single configuration file
# Fill in the values you need. Defaults work for a local Docker setup.
# =============================================================================

# --- Application ---
APP_NAME=pdf-extractor
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*

# --- Storage ---
# local = filesystem under STORAGE_ROOT
# s3    = S3-compatible object storage (fill S3_* below)
STORAGE_BACKEND=local
STORAGE_ROOT=./data

# S3 / MinIO (used when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=extraction

# --- Database ---
# SQLite by default. For Postgres use:
# DATABASE_URL=postgresql+psycopg://user:password@postgres:5432/extraction
DATABASE_URL=sqlite:///./data/extractor.db

# --- Worker ---
# inline   = API process runs extraction in a background thread (local dev)
# external = API only enqueues; run `python -m app.workers.extraction_worker`
WORKER_MODE=external
WORKER_POLL_SECONDS=2
WORKER_CLAIM_BATCH=1

# --- Upload limits ---
MAX_PDF_SIZE_MB=50
MAX_PAGES=200

# --- Rendering ---
RENDER_DPI=200
RENDER_IMAGE_FORMAT=png

# --- OCR ---
# tesseract | paddle
OCR_ENABLED=true
OCR_ENGINE=tesseract
OCR_LANGUAGES=eng
TESSERACT_CMD=tesseract
PADDLE_OCR_USE_GPU=false
PADDLE_OCR_LANG=en

# --- Tables ---
# pymupdf | docling
TABLE_ENGINE=pymupdf
DOCLING_ENABLED=false

# --- Layout ---
# pymupdf (heuristic blocks + tables + images)
LAYOUT_ENGINE=pymupdf

# --- VLM (charts, diagrams, low-confidence / conflict regions) ---
VLM_ENABLED=false
# openai | azure_openai | anthropic | openai_compatible
VLM_PROVIDER=openai
VLM_API_KEY=
VLM_BASE_URL=https://api.openai.com/v1
VLM_MODEL=gpt-4o-mini
VLM_TIMEOUT_SECONDS=60
VLM_MAX_TOKENS=2048
# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Native text quality / scan detection ---
MIN_NATIVE_TEXT_CHARS=20
SCANNED_TEXT_DENSITY_THRESHOLD=50
NATIVE_TEXT_GARBAGE_RATIO=0.35

# --- Validation / review ---
CONFIDENCE_HIGH=0.90
CONFIDENCE_MEDIUM=0.75
REVIEW_CONFIDENCE_THRESHOLD=0.75
HALT_PIPELINE_ON_REVIEW=false
ENABLE_ARITHMETIC_CHECKS=true
